{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react", // optional in TS 4.5+, usually safe to include
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "@ts/*": [
        "src/scripts/*"
      ],
      "@css/*": [
        "src/styles/*"
      ],
      "@/*": [
        "src/*"
      ],
    },
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}