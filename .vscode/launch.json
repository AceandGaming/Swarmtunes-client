{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch SwarmTunes (Vite)",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "vite dev",
            "runtimeArgs": [
                "--disable-web-security",
                "--ignore-certificate-errors",
                "--user-data-dir=dev"
            ]
        }
    ]
}